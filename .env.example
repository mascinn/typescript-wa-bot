# Timezone proses (otomatis disamakan dengan PRAYER_TIMEZONE oleh bot)
TZ=Asia/Jakarta

PRAYER_API_URL=https://api.aladhan.com/v1
PRAYER_CITY=Bandar Lampung
PRAYER_COUNTRY=Indonesia
PRAYER_METHOD=20
PRAYER_TIMEZONE=Asia/Jakarta

# Berapa menit sebelum waktu shalat reminder dikirim (Dzuhur–Isya)
REMINDER_MINUTES=15

# JID grup tujuan (wajib). Kirim pesan di grup, lalu salin "JID : ...@g.us" dari log.
WHATSAPP_GROUP_JID=

# (Opsional) Nomor yang boleh menjalankan /kirimjadwal selain admin grup, pisahkan dengan koma
ADMIN_NUMBERS=

# (Opsional) Lokasi foto jadwal. Default: assets/jadwal.jpg / .jpeg / .png
JADWAL_IMAGE_PATH=
# (Opsional) Caption foto jadwal
JADWAL_IMAGE_CAPTION=

# (Opsional) Port halaman QR / health check
PORT=3000

# (Opsional/Rekomendasi untuk Render) Turso Database untuk session & state persisten
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=